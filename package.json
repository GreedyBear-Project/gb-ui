{
  "name": "@greedybear/gb-ui",
  "version": "1.0.0",
  "description": "GreedyBear frontend components library (react.js, reactstrap, etc)",
  "author": "GreedyBear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreedyBear-Project/gb-ui"
  },
  "bugs": {
    "url": "https://github.com/GreedyBear-Project/gb-ui/issues"
  },
  "homepage": "https://github.com/GreedyBear-Project/gb-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "vite build",
    "start": "vite build --watch",
    "prepare": "run-s build",
    "test": "run-s test:unit test:lint test:build ",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "vitest run --config vitest.config.mjs --passWithNoTests",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest --config vitest.config.mjs",
    "predeploy": "cd example && npm install && npm run build",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "npm run lint -- --fix",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "pretty-quick": "pretty-quick --staged"
  },
  "peerDependencies": {
    "axios": "^1.6.0",
    "axios-hooks": "^5.1.1",
    "bootstrap": "^5.2.1",
    "formik": "^2.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.3.0 || ^7.0.0",
    "reactstrap": "^9.0.3"
  },
  "dependencies": {
    "@microlink/react-json-view": "^1.31.18",
    "@tanstack/react-table": "^8.21.3",
    "classnames": "^2.3.1",
    "date-fns": "^2.28.0",
    "match-sorter": "^6.3.1",
    "nanoid": "^3.3.4",
    "react-compound-slider": "^3.3.1",
    "react-icons": "^4.3.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-json-editor-ajrm": "^2.5.13",
    "react-select": "^5.10.2",
    "react-share": "^5.3.0",
    "react-top-loading-bar": "^3.0.2",
    "react-use": "^17.6.0",
    "recharts": "^3.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.1.4",
    "axios": "^1.13.5",
    "axios-hooks": "^5.1.1",
    "bootstrap": "^5.3.8",
    "eslint": "^8.16.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "formik": "^2.4.9",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "pretty-quick": "^3.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "reactstrap": "^9.2.3",
    "sass": "^1.100.0",
    "vitest": "^3.2.6"
  }
}
